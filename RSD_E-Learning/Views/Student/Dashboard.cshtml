@model RSD_E_Learning.ViewModels.StudentDashboardVm

@{
    ViewData["Title"] = "Student Dashboard";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <style>
        body {
            background: #f6f7f9;
            margin: 0;
            font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            color: #222;
        }

        .dashboard-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 32px 20px;
        }

        .dashboard-header {
            margin-bottom: 32px;
        }

            .dashboard-header h1 {
                font-size: 2rem;
                margin-bottom: 6px;
            }

            .dashboard-header p {
                color: #555;
            }

        .quick-actions {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 16px;
            margin-bottom: 40px;
        }

        .action-card {
            background: #fff;
            border: 1px solid #ddd;
            border-radius: 8px;
            padding: 24px;
            text-decoration: none;
            color: inherit;
            transition: box-shadow 0.2s ease;
        }

            .action-card:hover {
                box-shadow: 0 6px 14px rgba(0,0,0,0.08);
            }

        .action-card-icon {
            font-size: 2rem;
            margin-bottom: 12px;
        }

        .action-card-title {
            font-size: 1.2rem;
            font-weight: 600;
        }

        .action-card-description {
            font-size: 0.95rem;
            color: #555;
        }

        .section-title {
            font-size: 1.4rem;
            margin-bottom: 16px;
        }

        .activity-section {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 20px;
            margin-bottom: 40px;
        }

        .activity-card {
            background: #fff;
            border: 1px solid #ddd;
            border-radius: 6px;
            padding: 20px;
        }

        .empty-text {
            color: #888;
            font-style: italic;
        }

        .tips li {
            margin-bottom: 8px;
        }
    </style>
</head>

<body>
    <div class="dashboard-container">

        <!-- Header -->
        <div class="dashboard-header">
            <h1>Student Dashboard</h1>
            <p>
                Welcome back,
                <strong>@(User.FindFirst("FullName")?.Value ?? User.Identity.Name)</strong>
                👋 Learning is Life, Life is Learning!
            </p>
        </div>

        <!-- Quick Actions -->
        <div class="quick-actions">

            <a class="action-card" asp-controller="Courses" asp-action="Catalog">
                <div class="action-card-icon">📘</div>
                <div class="action-card-title">Browse Courses</div>
                <div class="action-card-description">Explore new courses and enroll</div>
            </a>

            <a class="action-card" asp-controller="StudentCourse" asp-action="MyCourses">
                <div class="action-card-icon">🎓</div>
                <div class="action-card-title">My Courses</div>
                <div class="action-card-description">View courses you are enrolled in</div>
            </a>

        </div>

        <!-- Activity Section -->
        <h2 class="section-title">Recent Learning Activity</h2>
        <div class="activity-section">
            <div class="activity-card">
                <h3>📅 Recent Lessons</h3>

                @if (!Model.RecentLessons.Any())
                {
                    <p class="empty-text">No lessons yet</p>
                }
                else
                {
                    <ul>
                        @foreach (var l in Model.RecentLessons)
                        {
                            <li>
                                <strong>@l.CourseTitle</strong><br />
                                @l.LessonTitle
                                <small class="text-muted">
                                    (@l.ScheduleDate?.ToString("dd MMM yyyy"))
                                </small>
                            </li>
                        }
                    </ul>
                }
            </div>


            <div class="activity-card">
                <h3>📝 Pending Final Exams</h3>

                @if (!Model.PendingFinalExams.Any())
                {
                    <p class="empty-text">No pending Final Exams</p>
                }
                else
                {
                    <ul>
                        @foreach (var f in Model.PendingFinalExams)
                        {
                            <li>
                                <strong>@f.CourseTitle</strong><br />
                                @f.Title<br />
                                <small>
                                    Deadline: @f.DeadLine.ToString("dd MMM yyyy") |
                                    Attempts: @f.AttemptsUsed / 3
                                </small><br />

                                <a asp-controller="StudentFinalExam"
                                   asp-action="Attempt"
                                   asp-route-finalId="@f.FinalId">
                                    Attempt
                                </a>
                            </li>
                        }
                    </ul>
                }
            </div>

        </div>

        <!-- Study Tips -->
        <h2 class="section-title">📌 Study Tips</h2>
        <div class="activity-card">
            <ul class="tips">
                <li>Always remember: There is no end towards learning.</li>
                <li>Complete lessons before attempting assessments.</li>
                <li>Don’t play while studying, bad habit #1.</li>
                <li>Don’t cheat on tests, bad habit #2.</li>
                <li>Revise regularly instead of last-minute studying.</li>
            </ul>
        </div>

    </div>
</body>
</html>
