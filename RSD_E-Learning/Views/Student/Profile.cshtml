@model RSD_E_Learning.Models.DB.Student

@{
    ViewData["Title"] = "My Profile";
    var transactions = ViewBag.Transactions as List<RSD_E_Learning.Models.DB.PaymentTransaction>;
}

<div class="container mt-4">

    <h2>👤 My Profile</h2>
    <hr />

    <!-- BASIC INFO -->
    <div class="card mb-4">
        <div class="card-header">
            <strong>Personal Information</strong>
        </div>
        <div class="card-body">
            <p><strong>Name:</strong> @Model.User?.FullName</p>
            <p><strong>Email:</strong> @Model.User?.Email</p>
            <p><strong>Birthday:</strong> <span class="text-muted">Not provided</span></p>
        </div>
    </div>

    <!-- ENROLLMENTS -->
    <div class="card mb-4">
        <div class="card-header">
            <strong>📚 Enrolled Courses</strong>
        </div>
        <div class="card-body">
            @if (!Model.Enrollments.Any())
            {
                <p class="text-muted">No enrolled courses yet.</p>
            }
            else
            {
                <ul class="list-group">
                    @foreach (var e in Model.Enrollments)
                    {
                        <li class="list-group-item">
                            <strong>@e.Course?.Title</strong><br />
                            <small class="text-muted">
                                Enrolled on @e.EnrolledAt.ToString("dd MMM yyyy")
                            </small>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>

    <!-- TRANSACTIONS -->
    <div class="card">
        <div class="card-header">
            <strong>💳 Transaction History</strong>
        </div>
        <div class="card-body">
            @if (transactions == null || !transactions.Any())
            {
                <p class="text-muted">No payment records found.</p>
            }
            else
            {
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Course</th>
                            <th>Amount</th>
                            <th>Payment Method</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in transactions)
                        {
                            <tr>
                                <td>@t.Course?.Title</td>
                                <td>RM @t.Amount</td>
                                <td>@t.PaymentMethod</td>
                                <td>@t.TransactionDate.ToString("dd MMM yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

</div>
