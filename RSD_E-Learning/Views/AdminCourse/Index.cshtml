@model RSD_E_Learning.Models.CourseFilterVm
@Html.AntiForgeryToken()

@{
    ViewData["Title"] = "Manage Courses";
}

<h2 class="mb-3">Manage Courses</h2>

<!-- SEARCH + FILTER -->
<form method="get" class="row g-2 mb-3">
    <div class="col-md-4">
        <input name="search"
               value="@Model.Search"
               class="form-control"
               placeholder="Search course or teacher" />
    </div>

    <div class="col-md-4">
        <select name="filter" class="form-select">
            <option value="all" selected="@(Model.Filter == "all")">All</option>
            <option value="pending" selected="@(Model.Filter == "pending")">Pending</option>
            <option value="approved" selected="@(Model.Filter == "approved")">Approved</option>
            <option value="rejected" selected="@(Model.Filter == "rejected")">Rejected</option>
        </select>
    </div>

    <div class="col-md-2 d-grid">
        <button class="btn btn-primary">Filter</button>
    </div>
</form>

<!-- TABLE -->
<table class="table table-bordered align-middle">
    <thead class="table-light">
        <tr>
            <th>Title</th>
            <th>Teacher</th>
            <th>Category</th>
            <th>Status</th>
            <th>Publish</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var course in Model.Courses)
        {
            <tr>
                <td>@course.Title</td>
                <td>@course.Teacher?.User?.FullName</td>
                <td>@course.Category?.Name</td>

                <td>
                    @if (course.IsRejected)
                    {
                        <span class="badge bg-danger">Rejected</span>
                    }
                    else if (!course.IsApproved)
                    {
                        <span class="badge bg-warning">Pending</span>
                    }
                    else
                    {
                        <span class="badge bg-success">Approved</span>
                    }
                </td>

                <td>
                    @if (course.IsApproved && !course.IsRejected)
                    {
                        <button type="button"
                                class="btn btn-sm toggle-btn fixed-btn
                                               @(course.IsPublished ? "btn-outline-danger" : "btn-outline-success")"
                                data-id="@course.CourseId">
                            @(course.IsPublished ? "Unpublish" : "Publish")
                        </button>
                    }
                    else
                    {
                        <span class="text-muted">N/A</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-controller="AdminDashboard"
   asp-action="Index"
   class="btn btn-secondary mt-3">
    ← Back to Dashboard
</a>

@section Scripts {
    <script>
        document.querySelectorAll('.toggle-btn').forEach(btn => {
            btn.addEventListener('click', function () {

                const id = this.dataset.id;
                const button = this;

                fetch('/AdminCourse/TogglePublishAjax', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken':
                            document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({ id: parseInt(id) })
                })
                .then(res => res.json())
                .then(data => {
                    if (!data.success) {
                        alert(data.message ?? 'Action failed');
                        return;
                    }

                    if (data.isPublished) {
                        button.innerText = 'Unpublish';
                        button.className = 'btn btn-sm btn-outline-danger toggle-btn fixed-btn';
                    } else {
                        button.innerText = 'Publish';
                        button.className = 'btn btn-sm btn-outline-success toggle-btn fixed-btn';
                    }
                });
            });
        });
    </script>
}
