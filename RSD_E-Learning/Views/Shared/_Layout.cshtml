<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RSD_E_Learning</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RSD_E_Learning.styles.css" asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom mb-3">
            <div class="container-fluid">

                <!-- BRAND -->
                <a class="navbar-brand fw-bold"
                   asp-controller="Home"
                   asp-action="Index">
                    RSD_E_Learning
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">

                    <!-- LEFT -->
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        @* Student dashboard only *@
                        @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Student"))
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Student"
                                   asp-action="Dashboard">
                                    Dashboard
                                </a>
                            </li>
                        }
                    </ul>

                    <!-- RIGHT -->
                    <ul class="navbar-nav ms-auto">

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <span class="nav-link text-muted">
                                    Hello, @User.Identity?.Name
                                </span>
                            </li>

                            <li class="nav-item">
                                <form asp-controller="Account"
                                      asp-action="Logout"
                                      method="post">
                                    <button type="submit"
                                            class="btn btn-link nav-link">
                                        Logout
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <!-- ADMIN LOGIN -->
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="AdminLogin"
                                   asp-action="Login">
                                    Admin Login
                                </a>
                            </li>

                            <!-- TEACHER LOGIN -->
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Teacher"
                                   asp-action="TeacherLogin">
                                    Teacher Login
                                </a>
                            </li>
                        }

                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top mt-5 pt-4 pb-3">
        <div class="container">
            <div class="row text-muted">

                <div class="col-md-4 mb-3">
                    <h6 class="fw-bold text-dark">RSD E-Learning</h6>
                    <p class="small">
                        A secure e-learning platform supporting students, teachers,
                        and administrators through structured digital education.
                    </p>
                </div>

                <div class="col-md-2 mb-3">
                    <h6 class="fw-bold text-dark">Quick Links</h6>
                    <ul class="list-unstyled small">
                        <li>
                            <a asp-controller="Home"
                               asp-action="Index"
                               class="text-muted text-decoration-none">
                                Home
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Home"
                               asp-action="Privacy"
                               class="text-muted text-decoration-none">
                                Privacy Policy
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="col-md-3 mb-3">
                    <h6 class="fw-bold text-dark">Our Team</h6>
                    <p class="small">
                        Developed by educators and system designers
                        focused on digital learning solutions.
                    </p>
                    <p class="small">📍 Malaysia</p>
                </div>

                <div class="col-md-3 mb-3">
                    <h6 class="fw-bold text-dark">Contact Us</h6>
                    <p class="small mb-1">📧 support@rsd-elearning.com</p>
                    <p class="small mb-1">☎ +60 12-345 6789</p>
                </div>

            </div>

            <div class="text-center text-muted small mt-3">
                © 2025 RSD E-Learning. All rights reserved.
            </div>
        </div>
    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
