@model IEnumerable<RSD_E_Learning.Models.DB.Enrollment>

<table class="table table-bordered align-middle">
    <thead class="table-light">
        <tr>
            <th>Student</th>
            <th>Email</th>
            <th>Course</th>
            <th>Amount (RM)</th>
            <th>Method</th>
            <th>Status</th>
            <th>Paid At</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="7" class="text-center text-muted">
                    No transactions found
                </td>
            </tr>
        }
        else
        {
            foreach (var t in Model)
            {
                <tr>
                    <td>@t.Student.User.FullName</td>
                    <td>@t.Student.User.Email</td>
                    <td>@t.Course.Title</td>
                    <td>@t.AmountPaid.ToString("0.00")</td>
                    <td>@t.PaymentMethod</td>
                    <td>
                        <span class="badge bg-success">Paid</span>
                    </td>
                    <td>@t.EnrolledAt.ToString("dd MMM yyyy")</td>
                </tr>
            }
        }
    </tbody>
</table>
