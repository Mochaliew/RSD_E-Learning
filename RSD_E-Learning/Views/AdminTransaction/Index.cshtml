@model IEnumerable<RSD_E_Learning.Models.DB.Enrollment>

@{
    ViewData["Title"] = "Transaction History";
    Layout = "_Layout";
}

<h2>Transaction History</h2>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Student</th>
            <th>Course</th>
            <th>Payment Date</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var t in Model)
        {
            <tr>
                <td>@t.Student!.User!.FullName</td>
                <td>@t.Course!.Title</td>
                <td>@t.EnrolledAt.ToString("dd MMM yyyy")</td>
                <td>
                    <span class="badge bg-success">Paid</span>
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-controller="AdminDashboard"
   asp-action="Index"
   class="btn btn-secondary mt-3">
    ← Back to Dashboard
</a>
