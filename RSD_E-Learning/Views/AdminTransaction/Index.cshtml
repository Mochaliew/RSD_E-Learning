@{
    ViewData["Title"] = "Transactions";
}

@Html.AntiForgeryToken()

<h2 class="mb-3">Transactions</h2>

<!-- ================= FILTER ================= -->
<form id="filterForm" class="row g-3 mb-4 align-items-end">

    <div class="col-md-4">
        <label class="form-label fw-semibold">Filter by Course</label>
        <select id="courseId" class="form-select">
            <option value="">All Courses</option>
            @foreach (var c in ViewBag.Courses)
            {
                <option value="@c.CourseId">@c.Title</option>
            }
        </select>
    </div>

    <div class="col-md-3">
        <label class="form-label fw-semibold">Start Date</label>
        <input type="date" id="startDate" class="form-control" />
    </div>

    <div class="col-md-3">
        <label class="form-label fw-semibold">End Date</label>
        <input type="date" id="endDate" class="form-control" />
    </div>

    <div class="col-md-2 d-grid">
        <button class="btn btn-primary">Apply</button>
    </div>
</form>

<!-- ================= AJAX TABLE ================= -->
<div id="transactionTable">
    <div class="text-muted text-center py-4">
        Loading transactions...
    </div>
</div>

<a asp-controller="AdminStudent"
   asp-action="Index"
   class="btn btn-secondary mt-3">
    ← Back
</a>

@section Scripts {
    <script>
        function loadTransactions() {
            const courseId = document.getElementById('courseId').value;
            const startDate = document.getElementById('startDate').value;
            const endDate = document.getElementById('endDate').value;

            const params = new URLSearchParams({
                courseId,
                startDate,
                endDate
            });

            fetch('/AdminTransaction/AjaxList?' + params.toString())
                .then(res => res.text())
                .then(html => {
                    document.getElementById('transactionTable').innerHTML = html;
                });
        }

        document.getElementById('filterForm').addEventListener('submit', function (e) {
            e.preventDefault();
            loadTransactions();
        });

        // Initial load
        loadTransactions();
    </script>
}
