@{
    ViewData["Title"] = "Teacher Zone";
}

<!DOCTYPE html>
<html lang="en">

    <head>

        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>@ViewData["Title"]</title>
        <link rel="stylesheet" href="~/css/Teacher.css" />

    </head>

    <body>

        <div>
            <!-- Header -->
            <div class="zone-header">
                <h1>Teacher Zone</h1>
                <p>Welcome back! <strong>@User.Identity.Name</strong></p>
            </div>

            <!-- Main Action Buttons -->
            <div class="action-buttons">
                <a class="btn btn-primary" asp-controller="Teacher" asp-action="CreateCourse">
                    <span class="btn-label">Create Course</span>
                </a>
                <a class="btn btn-primary" asp-controller="Teacher" asp-action="ViewCourse">
                    <span class="btn-label">View Courses' Detail</span>
                </a>
                <a class="btn btn-primary" asp-controller="Teacher" asp-action="CreateAssessment">
                    <span class="btn-label">Create Assessment</span>
                </a>
                <a class="btn btn-primary" asp-controller="Teacher" asp-action="ViewAssessment">
                    <span class="btn-label">View Assessments' Detail</span>
                </a>
            </div>

            <div class="dashboard-preview">
                <div class="preview-header">
                    <h2>  Quick DashBoard  </h2>
                        <a asp-controller="Teacher" asp-action="TeacherDashboard" class="expand-btn">View Full Dashboard</a> 

                </div>

                <div class="preview-stats">
                    <div class="preview-stat-card">
                        <div class="stat-number"></div>
                        <div class="stat-title">Show number of course</div>
                    </div>
                    <div class="preview-stat-card">
                        <div class="stat-number"></div>
                        <div class="stat-title">show number of students</div>
                    </div>
                    <div class="preview-stat-card">
                        <div class="stat-number"></div>
                        <div class="stat-title">show number of assessment</div>
                    </div>
                    <div class="preview-stat-card">
                        <div class="stat-number"></div>
                        <div class="stat-title">show passing rate?</div>
                    </div>
                </div>

                <div class="preview-recent">
                    <div class="recent-section">
                        <h3>Recent Courses</h3>
                            <p class="empty-text">No courses yet</p>
                    </div>

                    <div class="recent-section">
                        <h3>Recent Assessments</h3>
                            <p class="empty-text">No assessments yet</p>
                    </div>
                </div>

            </div>
        </div>

        <script src="~/js/teacher.js"></script>
    </body>

</html>
