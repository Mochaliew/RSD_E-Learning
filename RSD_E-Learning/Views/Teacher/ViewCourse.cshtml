@using RSD_E_Learning.Models
@model IEnumerable<RSD_E_Learning.Models.DB.Course>

@{
    ViewData["Title"] = "My Courses";
    var courses = Model?.ToList() ?? new List<RSD_E_Learning.Models.DB.Course>();

    var approvedCourses = courses.Where(c => c.IsApproved && !c.IsRejected).ToList();
    var pendingCourses = courses.Where(c => !c.IsApproved && !c.IsRejected).ToList();
    var rejectedCourses = courses.Where(c => c.IsRejected).ToList();

    var filter = Context.Request.Query["filter"].ToString();
    if (string.IsNullOrEmpty(filter)) filter = "all";

    var displayCourses = filter switch
    {
        "pending" => pendingCourses,
        "approved" => approvedCourses,
        "rejected" => rejectedCourses,
        _ => courses
    };
}

<style>
    .vc-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 40px 20px;
    }

    .vc-header {
        text-align: center;
        margin-bottom: 30px;
    }

        .vc-header h1 {
            font-size: 2.5rem;
            color: #333;
            margin-bottom: 20px;
        }

    .vc-actions {
        display: flex;
        justify-content: center;
        gap: 15px;
        flex-wrap: wrap;
        margin-bottom: 30px;
    }

    .vc-search {
        padding: 12px 20px;
        border: 2px solid #e0e0e0;
        border-radius: 8px;
        width: 300px;
        font-size: 1rem;
    }

    .vc-btn-create {
        background: #5b6ff5;
        color: white;
        padding: 12px 24px;
        border: none;
        border-radius: 8px;
        font-size: 1rem;
        text-decoration: none;
        display: inline-block;
    }

        .vc-btn-create:hover {
            background: #4a5ed8;
        }

    .vc-btn-dashboard {
        background: white;
        color: #333;
        padding: 12px 24px;
        border: 2px solid #e0e0e0;
        border-radius: 8px;
        font-size: 1rem;
        text-decoration: none;
        display: inline-block;
    }

        .vc-btn-dashboard:hover {
            border-color: #5b6ff5;
            color: #5b6ff5;
        }

    .vc-filter-tabs {
        display: flex;
        justify-content: center;
        gap: 10px;
        margin: 30px 0;
        flex-wrap: wrap;
    }

    .vc-filter-tab {
        padding: 10px 24px;
        border: 2px solid #e0e0e0;
        background: white;
        border-radius: 8px;
        font-size: 1rem;
        color: #666;
        text-decoration: none;
        display: inline-block;
    }

        .vc-filter-tab.vc-active {
            background: #5b6ff5;
            color: white;
            border-color: #5b6ff5;
        }

        .vc-filter-tab:hover {
            border-color: #5b6ff5;
        }

    .vc-empty {
        text-align: center;
        padding: 80px 20px;
    }

    .vc-empty-icon {
        font-size: 80px;
        margin-bottom: 20px;
    }

    .vc-empty h2 {
        font-size: 2rem;
        color: #333;
        margin-bottom: 10px;
    }

    .vc-empty p {
        color: #666;
        font-size: 1.1rem;
        margin-bottom: 30px;
    }

    .vc-btn-first {
        background: #5b6ff5;
        color: white;
        padding: 14px 32px;
        border: none;
        border-radius: 8px;
        font-size: 1.1rem;
        text-decoration: none;
        display: inline-block;
    }

    .vc-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 20px;
        margin-top: 30px;
    }

    .vc-card {
        background: white;
        border: 2px solid #e0e0e0;
        border-radius: 12px;
        padding: 20px;
        transition: all 0.3s;
    }

        .vc-card:hover {
            border-color: #5b6ff5;
            box-shadow: 0 4px 12px rgba(91, 111, 245, 0.1);
        }

        .vc-card h3 {
            font-size: 1.3rem;
            color: #333;
            margin-bottom: 10px;
        }

    .vc-meta {
        color: #666;
        font-size: 0.9rem;
        margin-bottom: 15px;
    }

    .vc-stats {
        display: flex;
        gap: 15px;
        margin: 15px 0;
        font-size: 0.9rem;
        color: #666;
    }

    .vc-badge {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 12px;
        font-size: 0.85rem;
        font-weight: 500;
        margin-bottom: 10px;
    }

    .vc-badge-approved {
        background: #d4edda;
        color: #155724;
    }

    .vc-badge-pending {
        background: #fff3cd;
        color: #856404;
    }

    .vc-badge-rejected {
        background: #f8d7da;
        color: #721c24;
    }

    .vc-actions-row {
        display: flex;
        gap: 10px;
        margin-top: 15px;
    }

    .vc-btn-small {
        padding: 8px 16px;
        border-radius: 6px;
        font-size: 0.9rem;
        text-decoration: none;
        border: none;
        flex: 1;
        text-align: center;
    }

    .vc-btn-primary {
        background: #5b6ff5;
        color: white;
    }

    .vc-btn-secondary {
        background: #f0f0f0;
        color: #333;
    }

    .vc-alert {
        padding: 15px 20px;
        border-radius: 8px;
        margin-bottom: 20px;
    }

    .vc-alert-success {
        background: #d4edda;
        color: #155724;
        border: 1px solid #c3e6cb;
    }

    .vc-alert-danger {
        background: #f8d7da;
        color: #721c24;
        border: 1px solid #f5c6cb;
    }

    .vc-rejection {
        background: #fff3cd;
        padding: 10px;
        border-radius: 6px;
        margin-top: 10px;
        font-size: 0.9rem;
    }
</style>

<div class="vc-container">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="vc-alert vc-alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="vc-alert vc-alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="vc-header">
        <h1>My Courses</h1>

        <div class="vc-actions">
            <input type="text" class="vc-search" id="searchInput" placeholder="Search courses..." />
            <a href="@Url.Action("CreateCourse", "Teacher")" class="vc-btn-create">+ Create Course</a>
            <a href="@Url.Action("TeacherIndex", "Teacher")" class="vc-btn-dashboard">Back to Dashboard</a>
        </div>
    </div>

    <div class="vc-filter-tabs">
        <a href="?filter=all" class="vc-filter-tab @(filter == "all" ? "vc-active" : "")">All Courses (@courses.Count)</a>
        <a href="?filter=pending" class="vc-filter-tab @(filter == "pending" ? "vc-active" : "")">Pending Approval (@pendingCourses.Count)</a>
        <a href="?filter=approved" class="vc-filter-tab @(filter == "approved" ? "vc-active" : "")">Approved (@approvedCourses.Count)</a>
        <a href="?filter=rejected" class="vc-filter-tab @(filter == "rejected" ? "vc-active" : "")">Rejected (@rejectedCourses.Count)</a>
    </div>

    @if (!courses.Any())
    {
        <div class="vc-empty">
            <div class="vc-empty-icon">📚</div>
            <h2>No Courses Yet</h2>
            <p>Start creating your first course to share knowledge with students</p>
            <a href="@Url.Action("CreateCourse", "Teacher")" class="vc-btn-first">Create Your First Course</a>
        </div>
    }
    else
    {
        @if (displayCourses.Any())
        {
            <div class="vc-grid">
                @foreach (var course in displayCourses)
                {
                    <div class="vc-card">
                        @if (course.IsRejected)
                        {
                            <span class="vc-badge vc-badge-rejected">Rejected</span>
                        }
                        else if (course.IsApproved)
                        {
                            <span class="vc-badge vc-badge-approved">Approved</span>
                        }
                        else
                        {
                            <span class="vc-badge vc-badge-pending">Pending Approval</span>
                        }

                        <h3>@course.Title</h3>
                        <div class="vc-meta">
                            <strong>Category:</strong> @(course.Category?.Name ?? "N/A")
                        </div>
                        <p>@(course.Description ?? "No description available")</p>

                        @if (course.IsRejected && !string.IsNullOrEmpty(course.RejectionReason))
                        {
                            <div class="vc-rejection">
                                <strong>Rejection Reason:</strong> @course.RejectionReason
                            </div>
                        }

                        <div class="vc-stats">
                            <span>👥 @(course.Enrollments?.Count ?? 0) Students</span>
                            <span>📖 @(course.Lessons?.Count ?? 0) Lessons</span>
                            <span>📝 @(course.Assessments?.Count ?? 0) Assessments</span>
                        </div>

                        <div class="vc-actions-row">
                            @if (course.IsApproved)
                            {
                                <a href="@Url.Action("UploadMaterial", "Teacher", new { courseId = course.CourseId })" class="vc-btn-small vc-btn-primary">Upload Material</a>
                                <a href="@Url.Action("CreateAssessment", "Teacher", new { courseId = course.CourseId })" class="vc-btn-small vc-btn-primary">Create Assessment</a>
                                <a href="@Url.Action("CourseDetail", "Teacher", new { id = course.CourseId })" class="vc-btn-small vc-btn-primary">View Details</a>
                            }
                            else if (!course.IsApproved && course.IsRejected)
                            {
                                <a href="#" class="vc-btn-small vc-btn-secondary">lmao rejected</a>
                            }
                            else
                            {
                                <a href="#" class="vc-btn-small vc-btn-secondary">Be patient</a>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="vc-empty">
                <div class="vc-empty-icon">📚</div>
                <h2>No @(filter == "pending" ? "Pending" : filter == "approved" ? "Approved" : "Rejected") Courses</h2>
                <p>@(filter == "pending" ? "All your courses have been reviewed" : filter == "approved" ? "No approved courses yet" : "No rejected courses")</p>
            </div>
        }
    }
</div>

<script>
    const searchInput = document.getElementById('searchInput');
    if (searchInput) {
        searchInput.addEventListener('input', function() {
            const searchTerm = this.value.toLowerCase();
            const cards = document.querySelectorAll('.vc-card');

            cards.forEach(card => {
                const title = card.querySelector('h3').textContent.toLowerCase();
                const description = card.querySelector('p').textContent.toLowerCase();

                if (title.includes(searchTerm) || description.includes(searchTerm)) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });
        });
    }
</script>