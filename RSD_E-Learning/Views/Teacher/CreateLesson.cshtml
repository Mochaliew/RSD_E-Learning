@model RSD_E_Learning.Models.CreateLessonVm

@{
    ViewData["Title"] = "Create Lesson";
}

<link rel="stylesheet" href="~/css/Teacher.css" />

<div class="container" style="max-width: 800px; margin: 50px auto;">
    <div class="header">
        <h1>Create New Lesson</h1>
        <p>Course: <strong>@ViewBag.CourseName</strong></p>
    </div>

    <form asp-action="CreateLesson" asp-controller="Teacher" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="CourseId" />

        <div class="form-group">
            <label asp-for="Title">Lesson Title</label>
            <input type="text" asp-for="Title" placeholder="e.g., Introduction / Chapter / Recap / Review" required />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Description">Description</label>
            <textarea asp-for="Description" rows="4" placeholder="Brief description of what will be covered in this lesson"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="MeetLink">Meeting Link</label>
            <input type="text" asp-for="MeetLink" placeholder="e.g. meet1.google.com" required />
            <span asp-validation-for="MeetLink" class="text-danger"></span>
            <small style="color:#666; display: block; margin-top: 5px;">Provide the online meeting link (Google Meet, Zoom, etc.)</small>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label>Date</label>
                <input type="date" name="LessonDate" />
            </div>

            <div class="form-group">
                <label>Time</label>
                <input type="time" name="LessonTime" />
            </div>
        </div>

        <div class="button-group">
            <button type="submit" class="btn btn-primary">Create Lesson</button>
            <a href="@Url.Action("ViewLesson", "Teacher")" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
