@model RSD_E_Learning.Models.UploadCourseFileVm

@{
    ViewData["Title"] = "Upload Course Material";
}

<link rel="stylesheet" href="~/css/Teacher.css" />

<div class="container" style="max-width: 800px; margin: 50px auto;">
    <div class="header">
        <h1>Upload Course Material</h1>
        <p>Course: <strong>@ViewBag.CourseTitle</strong></p>
    </div>

    <form asp-action="UploadMaterial"
          asp-controller="Teacher"
          method="post"
          enctype="multipart/form-data">

        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="CourseId" />

        <div class="materials-section">
            <h3>Upload Material</h3>

            <div class="form-group">
                <label asp-for="materialType">Material Type</label>
                <select asp-for="materialType" class="material-type">
                    <option value="pdf">PDF Document</option>
                    <option value="video">Video</option>
                    <option value="document">Document</option>
                    <option value="presentation">Presentation</option>
                </select>
            </div>

            <div class="form-group">
                <label asp-for="materialTitle">Material Title</label>
                <input type="text" asp-for="materialTitle" placeholder="Enter material title" />
                <span asp-validation-for="materialTitle" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="materialFile">Upload File</label>
                <input type="file" asp-for="materialFile" accept=".pdf,.doc,.docx,.txt,.mp4,.avi,.mov,.ppt,.pptx" />
                <span asp-validation-for="materialFile" class="text-danger"></span>
                <small style="color:#666; display: block; margin-top: 5px;">Supported formats: PDF, DOC, DOCX, TXT, MP4, AVI, MOV, PPT, PPTX (Max: 100MB)</small>
            </div>
        </div>

        <div class="button-group">
            <button type="submit" class="btn btn-primary">Upload Material</button>
            <a href="@Url.Action("ViewCourse", "Teacher")" class="btn btn-cancel">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}