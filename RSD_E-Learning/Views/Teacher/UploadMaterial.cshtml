@model RSD_E_Learning.Models.UploadCourseFileVm

@{
    ViewData["Title"] = "Upload Course Material";
}

<h2 class="mb-3">Upload Course Material</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<form asp-action="UploadMaterial"
      method="post"
      enctype="multipart/form-data">

    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="CourseId" />

    <div class="mb-3">
        <label asp-for="materialTitle" class="form-label"></label>
        <input asp-for="materialTitle" class="form-control" />
        <span asp-validation-for="materialTitle" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="materialFile" class="form-label"></label>
        <input asp-for="materialFile" type="file" class="form-control" />
        <span asp-validation-for="materialFile" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>Material Type</label>
        <select name="materialType" class="material-type">
            <option value="pdf">PDF Document</option>
            <option value="video">Video</option>
            <option value="text">Text Lesson</option>
            <option value="code">Code Demo</option>
        </select>
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-primary">
            Upload Material
        </button>

        <a asp-action="TeacherIndex"
           class="btn btn-secondary ms-2">
            Cancel
        </a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

