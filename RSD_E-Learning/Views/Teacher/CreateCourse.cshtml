@model IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>

@{
    ViewData["Title"] = "Create New Course";
}

<link rel="stylesheet" href="~/css/Teacher.css" />

<div class="container mt-4">
    <div class="header">
        <h1>Create New Course</h1>
        <p>Fill in the details to create your course</p>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-error">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <form asp-controller="Teacher" asp-action="CreateCourse"
          method="post" enctype="multipart/form-data" id="courseForm">

        @Html.AntiForgeryToken()

        <div class="form-row">
            <div class="form-group">
                <label for="courseTitle">Course Title *</label>
                <input type="text" id="courseTitle" name="courseTitle"
                       required placeholder="Enter course title" maxlength="100">
            </div>

            <div class="form-group">
                <label for="category">Category *</label>
                <select id="category" name="category" required>
                    <option value="">Select category</option>
                    @foreach (var item in Model)
                    {
                        <option value="@item.Value">@item.Text</option>
                    }
                </select>
            </div>
        </div>

        <div class="form-group">
            <label for="description">Course Description *</label>
            <textarea id="description" name="description" required
                      placeholder="Describe what students will learn" rows="5"></textarea>
        </div>

        <div class="materials-section">
            <h3>Course Materials</h3>
            <p style="color:#666; margin-bottom:20px;">Upload course materials (PDF, video, docs)</p>

            <div id="materialsContainer">
                <div class="material-item">
                    <div class="form-group">
                        <label>Material Type</label>
                        <select name="materialType" class="material-type">
                            <option value="pdf">PDF Document</option>
                            <option value="video">Video</option>
                            <option value="text">Text Lesson</option>
                            <option value="code">Code Demo</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Material Title</label>
                        <input type="text" name="materialTitle" placeholder="Enter material title">
                    </div>

                    <div class="form-group">
                        <label>Upload File</label>
                        <input type="file" name="materialFile"
                               accept=".pdf,.doc,.docx,.txt,.mp4,.avi,.mov">
                        <small style="color:#666;">Max size: 100MB</small>
                    </div>
                </div>
            </div>

            <button type="button" class="add-material-btn" onclick="addMaterial()">+ Add More Material</button>
        </div>

        <div class="button-group">
            <button type="submit" class="btn btn-primary">Submit Course</button>
            <a asp-controller="Teacher" asp-action="TeacherIndex" class="btn btn-cancel">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/teacher.js"></script>

    <script>
        function addMaterial() {
            const container = document.getElementById('materialsContainer');
            const newMaterial = document.createElement('div');
            newMaterial.className = 'material-item';
            newMaterial.innerHTML = `
                <button type="button" class="remove-btn" onclick="removeMaterial(this)">Remove</button>
                <div class="form-group">
                    <label>Material Type</label>
                    <select name="materialType" class="material-type">
                        <option value="pdf">PDF Document</option>
                        <option value="video">Video</option>
                        <option value="text">Text Lesson</option>
                        <option value="code">Code Demo</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Material Title</label>
                    <input type="text" name="materialTitle" placeholder="Enter material title">
                </div>
                <div class="form-group">
                    <label>Upload File</label>
                    <input type="file" name="materialFile" accept=".pdf,.doc,.docx,.txt,.mp4,.avi,.mov">
                    <small style="color:#666;">Max size: 100MB</small>
                </div>
            `;
            container.appendChild(newMaterial);
        }

        function removeMaterial(button) {
            const items = document.querySelectorAll('.material-item');
            if (items.length > 1) {
                button.closest('.material-item').remove();
            } else {
                alert("Bro… you must at least have one material 😭");
            }
        }

        document.getElementById('courseForm').addEventListener('submit', function (e) {
            const title = courseTitle.value.trim();
            const category = document.getElementById('category').value;
            const desc = description.value.trim();

            if (!title || !category || !desc) {
                e.preventDefault();
                alert('Required fields missing 😭');
                return;
            }

            const btn = this.querySelector('button[type="submit"]');
            btn.disabled = true;
            btn.textContent = "Creating Course...";
        });
    </script>
}
