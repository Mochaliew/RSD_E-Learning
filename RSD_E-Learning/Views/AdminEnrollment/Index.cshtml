@model IEnumerable<RSD_E_Learning.Models.DB.Enrollment>

@{
    ViewData["Title"] = "Enrollment Management";
    Layout = "_Layout";
}

<h2>Enrollment Management</h2>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Student</th>
            <th>Course</th>
            <th>Enrolled At</th>
            <th>Payment Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var e in Model)
        {
            <tr>
                <td>@e.Student!.User!.FullName</td>
                <td>@e.Course!.Title</td>
                <td>@e.EnrolledAt.ToString("dd MMM yyyy")</td>
                <td>
                    @if (e.PaymentStatus)
                    {
                        <span class="badge bg-success">Paid</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Unpaid</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-controller="AdminDashboard"
   asp-action="Index"
   class="btn btn-secondary mt-3">
    ← Back to Dashboard
</a>
