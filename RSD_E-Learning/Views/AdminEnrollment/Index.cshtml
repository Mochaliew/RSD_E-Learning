@model IEnumerable<RSD_E_Learning.Models.DB.Enrollment>

@{
    ViewData["Title"] = "Enrollment Management";
}

<h2 class="mb-3">Enrollment Management</h2>

<!-- ================= SEARCH & FILTER ================= -->
<form id="filterForm" class="row g-2 mb-4">

    <div class="col-md-5">
        <input name="search"
               class="form-control"
               placeholder="Search student, email or course" />
    </div>

    <div class="col-md-3">
        <select name="paymentStatus" class="form-select">
            <option value="">All Payments</option>
            <option value="true">Paid</option>
            <option value="false">Unpaid</option>
        </select>
    </div>

    <div class="col-md-2 d-grid">
        <button class="btn btn-primary">Apply</button>
    </div>

</form>

<!-- ================= TABLE ================= -->
<div id="enrollmentTable">
    @await Html.PartialAsync("_EnrollmentTable", Model)
</div>

<a asp-controller="AdminDashboard"
   asp-action="Index"
   class="btn btn-secondary mt-3">
    ← Back to Dashboard
</a>

@section Scripts {
    <script>
        const form = document.getElementById('filterForm');

        form.addEventListener('submit', function (e) {
            e.preventDefault();

            const params = new URLSearchParams(new FormData(form)).toString();

            fetch('/AdminEnrollment/Filter?' + params)
                .then(res => res.text())
                .then(html => {
                    document.getElementById('enrollmentTable').innerHTML = html;
                });
        });
    </script>
}
