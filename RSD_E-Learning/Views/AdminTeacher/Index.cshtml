@model IEnumerable<RSD_E_Learning.Models.DB.Teacher>

@{
    ViewData["Title"] = "Manage Teachers";
}

<h2>Manage Teachers</h2>

<div class="mb-3">
    <a asp-action="Create" class="btn btn-primary">
        + Add Teacher
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

<table class="table table-bordered align-middle">
    <thead class="table-light">
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Subject Area</th>
            <th>Status</th>
            <th style="width:260px;">Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var teacher in Model)
        {
            <tr>
                <td>@teacher.User?.FullName</td>
                <td>@teacher.User?.Email</td>
                <td>@teacher.SubjectArea</td>
                <td>
                    @if (teacher.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactive</span>
                    }
                </td>
                <td>

                    <!-- RESET PASSWORD (GET PAGE) -->
                    <a asp-action="ResetTeacherPassword"
                       asp-route-teacherId="@teacher.TeacherId"
                       class="btn btn-sm btn-outline-warning me-1">
                        Reset Password
                    </a>

                    <!-- ACTIVATE / DEACTIVATE (POST) -->
                    <form asp-action="ToggleStatus"
                          method="post"
                          class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="teacherId" value="@teacher.TeacherId" />

                        @if (teacher.IsActive)
                        {
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                Deactivate
                            </button>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-sm btn-outline-success">
                                Activate
                            </button>
                        }
                    </form>

                </td>
            </tr>
        }
    </tbody>
</table>

<div class="mt-4">
    <a asp-controller="AdminDashboard"
       asp-action="Index"
       class="btn btn-secondary">
        ← Back to Dashboard
    </a>
</div>
