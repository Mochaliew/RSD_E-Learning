@model RSD_E_Learning.Models.TeacherFilterVm

@{
    ViewData["Title"] = "Manage Teachers";
}

@Html.AntiForgeryToken()

<h2 class="mb-3">Manage Teachers</h2>

<div class="mb-3">
    <a asp-action="Create" class="btn btn-primary">
        + Add Teacher
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

<!-- ================= SEARCH & FILTER ================= -->
<form id="filterForm" class="row g-2 mb-4">

    <div class="col-md-4">
        <input name="search"
               value="@Model.Search"
               class="form-control"
               placeholder="Search name or email" />
    </div>

    <div class="col-md-3">
        <select name="isActive" class="form-select">
            <option value="">All Status</option>
            <option value="true" selected="@(Model.IsActive == true)">Active</option>
            <option value="false" selected="@(Model.IsActive == false)">Inactive</option>
        </select>
    </div>

    <div class="col-md-3">
        <select name="subjectArea" class="form-select">
            <option value="">All Subjects</option>
            @foreach (var subject in Model.SubjectAreas)
            {
                <option value="@subject"
                        selected="@(Model.SubjectArea == subject)">
                    @subject
                </option>
            }
        </select>
    </div>

    <div class="col-md-2 d-grid">
        <button class="btn btn-primary">
            Apply
        </button>
    </div>

</form>

<!-- ================= TABLE CONTAINER ================= -->
<div id="teacherTable">
    @await Html.PartialAsync("_TeacherTable", Model.Teachers)
</div>

<div class="mt-4">
    <a asp-controller="AdminDashboard"
       asp-action="Index"
       class="btn btn-secondary">
        ← Back to Dashboard
    </a>
</div>

@section Scripts {
    <script>
        const form = document.getElementById('filterForm');
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

        form.addEventListener('submit', function (e) {
            e.preventDefault();

            const params = new URLSearchParams(new FormData(form)).toString();

            fetch('/AdminTeacher/Filter?' + params)
                .then(res => res.text())
                .then(html => {
                    document.getElementById('teacherTable').innerHTML = html;
                    attachToggleHandlers();
                });
        });

        function attachToggleHandlers() {
            document.querySelectorAll('.toggle-btn').forEach(btn => {
                btn.onclick = function () {

                    const id = this.dataset.id;
                    const row = this.closest('tr');
                    const badge = row.querySelector('.status-badge');
                    const button = this;

                    fetch('/AdminTeacher/ToggleStatusAjax', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token
                        },
                        body: JSON.stringify({ id: parseInt(id) })
                    })
                    .then(res => res.json())
                    .then(data => {
                        if (!data.success) return;

                        if (data.isActive) {
                            badge.textContent = 'Active';
                            badge.className = 'badge status-badge bg-success';
                            button.textContent = 'Deactivate';
                            button.className = 'btn btn-sm btn-outline-danger toggle-btn fixed-btn';
                        } else {
                            badge.textContent = 'Inactive';
                            badge.className = 'badge status-badge bg-secondary';
                            button.textContent = 'Activate';
                            button.className = 'btn btn-sm btn-outline-success toggle-btn fixed-btn';
                        }
                    });
                };
            });
        }

        attachToggleHandlers();
    </script>
}
