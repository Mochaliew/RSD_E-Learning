@model RSD_E_Learning.Models.TeacherFilterVm

@{
    ViewData["Title"] = "Manage Teachers";
}

@Html.AntiForgeryToken()

<h2 class="mb-3">Manage Teachers</h2>

<div class="mb-3">
    <a asp-action="Create" class="btn btn-primary">
        + Add Teacher
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

<!-- 🔍 SEARCH & FILTER -->
<form method="get" class="row g-2 mb-3">

    <div class="col-md-4">
        <input name="search"
               value="@Model.Search"
               class="form-control"
               placeholder="Search name or email" />
    </div>

    <div class="col-md-3">
        <select name="isActive" class="form-select">
            <option value="">-- All Status --</option>
            <option value="true" selected="@(Model.IsActive == true)">Active</option>
            <option value="false" selected="@(Model.IsActive == false)">Inactive</option>
        </select>
    </div>

    <div class="col-md-3">
        <select name="subjectArea" class="form-select">
            <option value="">-- All Subjects --</option>
            @foreach (var subject in Model.SubjectAreas)
            {
                <option value="@subject"
                        selected="@(Model.SubjectArea == subject)">
                    @subject
                </option>
            }
        </select>
    </div>

    <div class="col-md-2 d-grid">
        <button class="btn btn-primary">Filter</button>
    </div>
</form>

<!-- 📋 TEACHERS TABLE -->
<table class="table table-bordered align-middle">
    <thead class="table-light">
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Subject Area</th>
            <th>Status</th>
            <th style="width:260px;">Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var teacher in Model.Teachers)
        {
            <tr>
                <td>@teacher.User?.FullName</td>
                <td>@teacher.User?.Email</td>
                <td>@teacher.SubjectArea</td>

                <td>
                    <span class="badge status-badge @(teacher.IsActive ? "bg-success" : "bg-secondary")">
                        @(teacher.IsActive ? "Active" : "Inactive")
                    </span>
                </td>

                <td>
                    <a asp-action="ResetTeacherPassword"
                       asp-route-teacherId="@teacher.TeacherId"
                       class="btn btn-sm btn-outline-warning me-1">
                        Reset Password
                    </a>

                    <button type="button"
                            class="btn btn-sm toggle-btn fixed-btn
                                       @(teacher.IsActive ? "btn-outline-danger" : "btn-outline-success")"
                            data-id="@teacher.TeacherId">
                        @(teacher.IsActive ? "Deactivate" : "Activate")
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="mt-4">
    <a asp-controller="AdminDashboard"
       asp-action="Index"
       class="btn btn-secondary">
        ← Back to Dashboard
    </a>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.toggle-btn').forEach(btn => {
            btn.addEventListener('click', function () {

                const id = this.dataset.id;
                const row = this.closest('tr');
                const badge = row.querySelector('.status-badge');
                const button = this;

                fetch('/AdminTeacher/ToggleStatusAjax', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken':
                            document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({ id: parseInt(id) })
                })
                .then(res => res.json())
                .then(data => {
                    if (!data.success) return;

                    if (data.isActive) {
                        badge.textContent = 'Active';
                        badge.className = 'badge status-badge bg-success';

                        button.textContent = 'Deactivate';
                        button.className = 'btn btn-sm btn-outline-danger toggle-btn fixed-btn';
                    } else {
                        badge.textContent = 'Inactive';
                        badge.className = 'badge status-badge bg-secondary';

                        button.textContent = 'Activate';
                        button.className = 'btn btn-sm btn-outline-success toggle-btn fixed-btn';
                    }
                });
            });
        });
    </script>
}
