@model IEnumerable<RSD_E_Learning.Models.DB.Teacher>

@{
    ViewData["Title"] = "Manage Teachers";
}

@Html.AntiForgeryToken()

<h2 class="mb-3">Manage Teachers</h2>

<div class="mb-3">
    <a asp-action="Create" class="btn btn-primary">
        + Add Teacher
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

<table class="table table-bordered align-middle">
    <thead class="table-light">
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Subject Area</th>
            <th>Status</th>
            <th style="width:260px;">Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var teacher in Model)
        {
            <tr>
                <td>@teacher.User?.FullName</td>
                <td>@teacher.User?.Email</td>
                <td>@teacher.SubjectArea</td>

                <!--STATUS (AJAX READY) -->
                <td>
                    <span class="badge status-badge @(teacher.IsActive ? "bg-success" : "bg-secondary")">
                        @(teacher.IsActive ? "Active" : "Inactive")
                    </span>
                </td>

                <!--ACTIONS -->
                <td>
                    <a asp-action="ResetTeacherPassword"
                       asp-route-teacherId="@teacher.TeacherId"
                       class="btn btn-sm btn-outline-warning me-1">
                        Reset Password
                    </a>

                    <button type="button"
                            class="btn btn-sm toggle-btn fixed-btn
                                       @(teacher.IsActive ? "btn-outline-danger" : "btn-outline-success")"
                            data-id="@teacher.TeacherId">
                        @(teacher.IsActive ? "Deactivate" : "Activate")
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="mt-4">
    <a asp-controller="AdminDashboard"
       asp-action="Index"
       class="btn btn-secondary">
        ← Back to Dashboard
    </a>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.toggle-btn').forEach(btn => {
            btn.addEventListener('click', function () {

                const id = this.dataset.id;
                const row = this.closest('tr');
                const badge = row.querySelector('.status-badge');
                const button = this;

                fetch('/AdminTeacher/ToggleStatusAjax', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken':
                            document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({ teacherId: parseInt(id) })
                })
                .then(res => res.json())
                .then(data => {
                    if (!data.success) return;

                    if (data.isActive) {
                        badge.className = 'badge bg-success status-badge';
                        badge.innerText = 'Active';
                        button.innerText = 'Deactivate';
                        button.className = 'btn btn-sm btn-outline-danger toggle-btn fixed-btn';
                    } else {
                        badge.className = 'badge bg-secondary status-badge';
                        badge.innerText = 'Inactive';
                        button.innerText = 'Activate';
                        button.className = 'btn btn-sm btn-outline-success toggle-btn fixed-btn';
                    }
                });
            });
        });
    </script>
}

}
