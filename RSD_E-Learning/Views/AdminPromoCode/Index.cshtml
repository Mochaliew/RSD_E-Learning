@{
    ViewData["Title"] = "Promo Codes";
}

@Html.AntiForgeryToken()

<h2 class="mb-3">Promo Codes</h2>

<form id="filterForm" class="row g-2 mb-3 align-items-end">

    <div class="col-md-4">
        <label class="form-label fw-semibold">Search</label>
        <input id="search" class="form-control" placeholder="Search promo code..." />
    </div>

    <div class="col-md-3">
        <label class="form-label fw-semibold">Status</label>
        <select id="status" class="form-select">
            <option value="">All</option>
            <option value="Active">Active</option>
            <option value="Inactive">Inactive</option>
            <option value="Upcoming">Upcoming</option>
            <option value="Expired">Expired</option>
        </select>
    </div>

    <div class="col-md-2 d-grid">
        <button class="btn btn-primary">Apply</button>
    </div>
</form>

<div class="mb-3">
    <a asp-action="Create" class="btn btn-success">
        + Add Promo Code
    </a>
</div>

<div id="promoTable">
    <div class="text-muted text-center py-4">
        Loading promo codes...
    </div>
</div>

<a asp-controller="AdminDashboard"
   asp-action="Index"
   class="btn btn-secondary mt-3">
    ← Back to Dashboard
</a>

@section Scripts {
    <script>
        const form = document.getElementById('filterForm');
        const searchInput = document.getElementById('search');
        const statusSelect = document.getElementById('status');
        const promoTable = document.getElementById('promoTable');
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

        function loadPromoCodes() {
            const search = encodeURIComponent(searchInput.value);
            const status = encodeURIComponent(statusSelect.value);

            fetch(`/AdminPromoCode/AjaxList?search=${search}&status=${status}`)
                .then(res => res.text())
                .then(html => promoTable.innerHTML = html);
        }

        // FILTER SUBMIT
        form.addEventListener('submit', function (e) {
            e.preventDefault();
            loadPromoCodes();
        });

        // TOGGLE ACTIVE / INACTIVE
        promoTable.addEventListener('click', function (e) {
            if (!e.target.classList.contains('toggle-btn')) return;

            fetch('/AdminPromoCode/ToggleAjax', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({
                    id: parseInt(e.target.dataset.id)
                })
            })
            .then(res => res.json())
            .then(data => {
                if (!data.success) {
                    alert(data.message ?? 'Action failed');
                    return;
                }
                loadPromoCodes();
            });
        });

        // INITIAL LOAD
        loadPromoCodes();
    </script>
}

