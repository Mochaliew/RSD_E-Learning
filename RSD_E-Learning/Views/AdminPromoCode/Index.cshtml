@{
    ViewData["Title"] = "Promo Codes";
}

@Html.AntiForgeryToken()

<h2 class="mb-3">Promo Codes</h2>

<!-- FILTER -->
<form id="filterForm" class="row g-2 mb-3 align-items-end">

    <div class="col-md-4">
        <label class="form-label fw-semibold">Search</label>
        <input id="search" class="form-control" placeholder="Search promo code..." />
    </div>

    <div class="col-md-3">
        <label class="form-label fw-semibold">Status</label>
        <select id="status" class="form-select">
            <option value="">All</option>
            <option value="Active">Active</option>
            <option value="Inactive">Inactive</option>
            <option value="Upcoming">Upcoming</option>
            <option value="Expired">Expired</option>
        </select>
    </div>

    <div class="col-md-2 d-grid">
        <button type="submit" class="btn btn-primary">
            Apply
        </button>
    </div>
</form>

<!-- AJAX TABLE CONTAINER -->
<div id="promoTable">
    <div class="text-muted text-center py-4">
        Loading promo codes...
    </div>
</div>

<a asp-controller="AdminDashboard"
   asp-action="Index"
   class="btn btn-secondary mt-3">
    ← Back to Dashboard
</a>

@section Scripts {
    <script>
        function loadPromoCodes() {
            const search = document.getElementById('search').value;
            const status = document.getElementById('status').value;

            fetch(`/AdminPromoCode/AjaxList?search=${encodeURIComponent(search)}&status=${status}`)
                .then(res => res.text())
                .then(html => {
                    document.getElementById('promoTable').innerHTML = html;
                });
        }

        // FILTER
        document.getElementById('filterForm').addEventListener('submit', function (e) {
            e.preventDefault();
            loadPromoCodes();
        });

        // ✅ EVENT DELEGATION FOR TOGGLE BUTTON
        document.getElementById('promoTable').addEventListener('click', function (e) {
            if (!e.target.classList.contains('toggle-btn')) return;

            const id = e.target.dataset.id;

            fetch('/AdminPromoCode/ToggleAjax', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken':
                        document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify({ id: parseInt(id) })
            })
            .then(res => res.json())
            .then(data => {
                if (!data.success) {
                    alert(data.message ?? 'Action failed');
                    return;
                }

                loadPromoCodes(); // refresh table
            });
        });

        // INITIAL LOAD
        loadPromoCodes();
    </script>
}

