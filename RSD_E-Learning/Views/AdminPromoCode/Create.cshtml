@model PromoCodeCreateVm
@{
    ViewData["Title"] = "Create Promo Code";
}

<h2 class="mb-4">Create Promo Code</h2>

<div class="card shadow-sm">
    <div class="card-body">
        <form method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="Code"></label>
                <input asp-for="Code" class="form-control" />
                <span asp-validation-for="Code" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DiscountPercent"></label>
                <input asp-for="DiscountPercent" class="form-control" />
                <span asp-validation-for="DiscountPercent" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="StartDate"></label>
                <input asp-for="StartDate" type="date" class="form-control" />
                <span asp-validation-for="StartDate" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ExpiryDate"></label>
                <input asp-for="ExpiryDate" type="date" class="form-control" />
                <span asp-validation-for="ExpiryDate" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="MaxUsage"></label>
                <input asp-for="MaxUsage" class="form-control" />
                <small class="text-muted">
                    Required (1 – 1000)
                </small>
                <span asp-validation-for="MaxUsage" class="text-danger"></span>
            </div>

            <div class="d-flex gap-3">
                <button class="btn btn-success px-4">Create</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
