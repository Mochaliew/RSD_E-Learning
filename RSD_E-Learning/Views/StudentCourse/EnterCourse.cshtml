@model RSD_E_Learning.Models.DB.Course

@{
    ViewData["Title"] = "Course Content";
}

<h2>@Model.Title</h2>

<p>
    <strong>Category:</strong> @Model.Category?.Name <br />
    <strong>Instructor:</strong> @Model.Teacher?.User?.FullName
</p>

<hr />

<hr />
<h4>Live Classes</h4>

@{
    var lessonsWithMeet = Model.Lessons?
        .Where(l => !string.IsNullOrEmpty(l.MeetLink))
        .ToList();
}

@if (lessonsWithMeet == null || !lessonsWithMeet.Any())
{
    <p>No live classes available.</p>
}
else
{
    <ul class="list-group mb-4">
        @foreach (var lesson in lessonsWithMeet)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                    <strong>@lesson.Title</strong><br />
                    <small class="text-muted">
                        Live session
                        @if (lesson.ScheduleDate != null)
                        {
                            <span> • @lesson.ScheduleDate.Value.ToString("dd MMM yyyy HH:mm")</span>
                        }
                    </small>
                </div>

                <a href="@lesson.MeetLink"
                   target="_blank"
                   class="btn btn-sm btn-success">
                    Join Class
                </a>
            </li>
        }
    </ul>
}


<!-- ================== COURSE MATERIALS ================== -->
<h4>Course Materials</h4>

@if (Model.Lessons != null && Model.Lessons.Any(l => l.CourseFiles.Any(f => f.IsActive)))
{
    foreach (var lesson in Model.Lessons)
    {
        var activeFiles = lesson.CourseFiles.Where(f => f.IsActive).ToList();

        if (activeFiles.Any())
        {
            <h5 class="mt-3">@lesson.Title</h5>

            <ul class="list-group mb-3">
                @foreach (var file in activeFiles)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <strong>@file.FileName</strong><br />
                            <small class="text-muted">@file.FileType</small>
                        </div>

                        <a asp-controller="StudentCourse"
                           asp-action="ViewMaterial"
                           asp-route-id="@file.CourseFileId"
                           class="btn btn-sm btn-primary">
                            View
                        </a>
                    </li>
                }
            </ul>
        }
    }
}
else
{
    <p>No materials available yet.</p>
}


<!-- ================== ASSESSMENTS ================== -->
<h4>Assessments (@(Model.Assessments?.Count ?? 0))</h4>

@if (Model.Assessments == null || !Model.Assessments.Any())
{
    <p>No assessments available.</p>
}
else
{
    <ul class="list-group">
        @foreach (var assessment in Model.Assessments.OrderBy(a => a.DeadLine))
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                    <strong>@assessment.Title</strong><br />
                    <small class="text-muted">
                        Deadline: @assessment.DeadLine.ToShortDateString()
                    </small>
                </div>

                <a asp-controller="StudentAssessment"
                   asp-action="Details"
                   asp-route-id="@assessment.AssessmentId"
                   class="btn btn-outline-primary btn-sm">
                    View Assessment
                </a>
            </li>
        }
    </ul>
}

