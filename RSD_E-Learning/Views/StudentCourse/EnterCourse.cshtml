@model RSD_E_Learning.Models.DB.Course

@{
    ViewData["Title"] = "Course Content";
}

<h2>@Model.Title</h2>

<p>
    <strong>Category:</strong> @Model.Category?.Name <br />
    <strong>Instructor:</strong> @Model.Teacher?.User?.FullName
</p>

<hr />

<hr />
<h4>Live Classes</h4>

@{
    var lessonsWithMeet = Model.Lessons?
        .Where(l => !string.IsNullOrEmpty(l.MeetLink))
        .ToList();
}

@if (lessonsWithMeet == null || !lessonsWithMeet.Any())
{
    <p>No live classes available.</p>
}
else
{
    <ul class="list-group mb-4">
        @foreach (var lesson in lessonsWithMeet)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                    <strong>@lesson.Title</strong><br />
                    <small class="text-muted">
                        Live session
                        @if (lesson.ScheduleDate != null)
                        {
                            <span> • @lesson.ScheduleDate.Value.ToString("dd MMM yyyy HH:mm")</span>
                        }
                    </small>
                </div>

                <a href="@lesson.MeetLink"
                   target="_blank"
                   class="btn btn-sm btn-success">
                    Join Class
                </a>
            </li>
        }
    </ul>
}

<hr />

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card text-center shadow-sm">
            <div class="card-body">
                <h5>📚 Materials</h5>
                <p>@Model.Lessons.Sum(l => l.CourseFiles.Count) items</p>
                <a asp-controller="StudentCourse"
                   asp-action="Materials"
                   asp-route-courseId="@Model.CourseId"
                   class="btn btn-outline-primary btn-sm">
                    View
                </a>

            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card text-center shadow-sm">
            <div class="card-body">
                <h5>📝 Assessments</h5>
                <p>@Model.Assessments.Count assessment(s)</p>
                <a asp-controller="StudentCourse"
                   asp-action="Assessments"
                   asp-route-courseId="@Model.CourseId"
                   class="btn btn-outline-primary btn-sm">
                    View
                </a>

            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card text-center shadow-sm">
            <div class="card-body">
                <h5>🎓 Certificate</h5>
                <p>Complete course</p>
                <a asp-action="Certificate"
                   asp-route-courseId="@Model.CourseId"
                   class="btn btn-outline-success btn-sm">
                    View
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card text-center shadow-sm">
            <div class="card-body">
                <h5>📝 Final Exams</h5>
                <p>@Model.FinalExams.Count Final Exam(s)</p>
                <a asp-controller="StudentFinalExam"
                   asp-action="Index"
                   asp-route-courseId="@Model.CourseId"
                   class="btn btn-outline-primary btn-sm">
                    View
                </a>

            </div>
        </div>
    </div>
</div>




