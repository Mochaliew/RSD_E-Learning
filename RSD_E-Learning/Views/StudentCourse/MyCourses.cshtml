@model List<RSD_E_Learning.ViewModels.StudentMyCourseVm>

<h2>My Enrolled Courses</h2>

<table class="table">
    <thead>
        <tr>
            <th>Course</th>
            <th>Category</th>
            <th>Instructor</th>
            <th>Progress</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Title</td>
                <td>@item.Category</td>
                <td>@item.Instructor</td>

                <td>
                    <div class="progress" style="height:20px;">
                        <div class="progress-bar"
                             role="progressbar"
                             style="width:@item.ProgressPercentage%">
                            @item.ProgressPercentage%
                        </div>
                    </div>
                </td>

                <td>
                    <a asp-controller="StudentCourse"
                       asp-action="EnterCourse"
                       asp-route-courseId="@item.CourseId"
                       class="btn btn-primary">
                        Enter Course
                    </a>

                    @if (item.ProgressPercentage == 100)
                    {
                        <a asp-controller="StudentCourse"
                           asp-action="Certificate"
                           asp-route-courseId="@item.CourseId"
                           class="btn btn-success ms-2">
                            Get Certificate
                        </a>
                    }
                </td>

            </tr>
        }
    </tbody>
</table>
