<link rel="stylesheet" href="~/css/student.css" />

<div class="student-container">
    <h2 class="mb-4">My Enrolled Courses</h2>

    <div class="student-grid">
        @foreach (var item in Model)
        {
            <div class="card-clean p-4">
                <h5>@item.Title</h5>
                <p class="text-muted">@item.Category</p>

                <div class="progress mb-3">
                    <div class="progress-bar" style="width:@item.ProgressPercentage%">
                        @item.ProgressPercentage%
                    </div>
                </div>

                <a asp-action="EnterCourse"
                   asp-route-courseId="@item.CourseId"
                   class="btn btn-primary btn-sm w-100 mb-2">
                    Enter Course
                </a>

                @if (item.ProgressPercentage == 100)
                {
                    <a asp-action="Certificate"
                       asp-route-courseId="@item.CourseId"
                       class="btn btn-success btn-sm w-100">
                        Get Certificate
                    </a>
                }
            </div>
        }
    </div>
</div>
