@model RSD_E_Learning.Models.DB.Course
@{
    ViewData["Title"] = "Course Details";
}

@if (TempData["Message"] != null)
{
    <div class="alert alert-info">
        @TempData["Message"]
    </div>
}

<h2>@Model.Title</h2>

<p>
    <strong>Category:</strong> @Model.Category?.Name <br />
    <strong>Instructor:</strong> @Model.Teacher?.User?.FullName
</p>

<p>@Model.Description</p>

<hr />

<h4>Lessons</h4>

@if (!Model.Lessons.Any())
{
    <p>No lessons available yet.</p>
}
else
{
    <ul class="list-group mb-3">
        @foreach (var lesson in Model.Lessons)
        {
            <li class="list-group-item">
                @lesson.Title
            </li>
        }
    </ul>
}

<hr />

<hr />

<h4>Assessments</h4>

@if (Model.Assessments == null || !Model.Assessments.Any())
{
    <p>No assessments available.</p>
}
else
{
    <ul class="list-group mb-3">
        @foreach (var assessment in Model.Assessments)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                    <strong>@assessment.Title</strong><br />
                    <small>
                        Deadline:
                        @assessment.DeadLine.ToString("dd/MM/yyyy")
                    </small>
                </div>

                <a asp-controller="StudentAssessment"
                   asp-action="Details"
                   asp-route-id="@assessment.AssessmentId"
                   class="btn btn-sm btn-outline-primary">
                    View Assessment
                </a>
            </li>
        }
    </ul>
}


@if ((bool)ViewBag.IsEnrolled)
{
    <a asp-controller="StudentCourse"
       asp-action="MyCourses"
       class="btn btn-primary">
        Go to My Courses
    </a>
}
else
{
    <a asp-controller="StudentCourse"
       asp-action="Payment"
       asp-route-courseId="@Model.CourseId"
       class="btn btn-success">
        Enroll Now
    </a>
}


