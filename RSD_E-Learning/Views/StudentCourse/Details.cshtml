@model RSD_E_Learning.Models.DB.Course

@{
    ViewData["Title"] = "Course Details";
}

@if (TempData["Message"] != null)
{
    <div class="alert alert-info">
        @TempData["Message"]
    </div>
}

<h2>@Model.Title</h2>

<p>
    <strong>Category:</strong> @Model.Category?.Name <br />
    <strong>Instructor:</strong> @Model.Teacher?.User?.FullName
</p>

<p>@Model.Description</p>

<hr />

<h4>Lessons</h4>

@if (!Model.Lessons.Any())
{
    <p>No lessons available yet.</p>
}
else
{
    <ul class="list-group mb-3">
        @foreach (var lesson in Model.Lessons)
        {
            <li class="list-group-item">
                @lesson.Title
            </li>
        }
    </ul>
}

<hr />

@if ((bool)ViewBag.IsEnrolled)
{
    <a asp-controller="StudentCourse"
       asp-action="MyCourses"
       class="btn btn-primary">
        Go to My Courses
    </a>
}
else
{
    <a asp-controller="StudentCourse"
       asp-action="Payment"
       asp-route-courseId="@Model.CourseId"
       class="btn btn-success">
        Enroll Now
    </a>
}
