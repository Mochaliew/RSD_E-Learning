@{
    ViewData["Title"] = "Certificate";
}

<div class="container text-center mt-5" style="border:3px solid #333; padding:40px;">
    <h2>Certificate of Completion</h2>

    <p class="mt-4">This is to certify that</p>

    <h3><strong>@ViewBag.StudentName</strong></h3>

    <p class="mt-3">
        has successfully completed the course
    </p>

    <h4><strong>@ViewBag.CourseTitle</strong></h4>

    <p class="mt-3">
        offered by <strong>RSD E-Learning Platform</strong>
    </p>

    <p class="mt-4">
        Instructor: @ViewBag.Instructor
    </p>

    <p>
        Date of Completion: @ViewBag.Date.ToString("dd MMM yyyy")
    </p>

    <hr />

    <p><em>This certificate is system-generated.</em></p>

    <button onclick="window.print()" class="btn btn-primary mt-3">
        Download / Print Certificate
    </button>
</div>
