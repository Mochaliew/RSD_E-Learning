@model RSD_E_Learning.Models.DB.Course

@{
    ViewData["Title"] = "Payment";
}

<h2>Course Payment</h2>

<hr />

<p>
    <strong>Course:</strong> @Model.Title <br />
    <strong>Category:</strong> @Model.Category?.Name <br />
    <strong>Price:</strong> RM @Model.Price.ToString("0.00")
</p>

<hr />

<form asp-action="ConfirmPayment" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" name="courseId" value="@Model.CourseId" />
    <input type="hidden" name="paymentToken" value="@ViewBag.PaymentToken" />



    <button type="submit" class="btn btn-success">
        Pay Now (Mock Payment)
    </button>

    <a asp-action="Details"
       asp-route-id="@Model.CourseId"
       class="btn btn-secondary ms-2">
        Cancel
    </a>
</form>
