@model IEnumerable<RSD_E_Learning.Models.DB.Category>

@{
    ViewData["Title"] = "Deleted Categories";
}

<h2 class="mb-3">Deleted Categories</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No deleted categories found.
    </div>
}
else
{
    <table class="table table-bordered align-middle">
        <thead class="table-light">
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th style="width:160px">Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Description</td>
                    <td>
                        <form asp-action="Restore"
                              method="post"
                              class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@item.CategoryId" />
                            <button class="btn btn-sm btn-success">
                                Restore
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="mt-4 d-flex gap-2">
    <a asp-action="Index" class="btn btn-secondary">
        ← Back to Categories
    </a>

    <a asp-controller="AdminDashboard"
       asp-action="Index"
       class="btn btn-outline-secondary">
        Back to Dashboard
    </a>
</div>
