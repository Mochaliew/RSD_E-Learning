@model IEnumerable<RSD_E_Learning.Models.DB.Category>

<h2>Categories</h2>

<a asp-action="Create" class="btn btn-primary mb-2">+ Add Category</a>

<a asp-action="Deleted" class="btn btn-outline-danger mb-2 ms-2">
    View Deleted Categories
</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Name</th>
            <th style="width:200px">Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@item.CategoryId"
                       class="btn btn-sm btn-warning">
                        Edit
                    </a>

                    <form asp-action="Delete"
                          method="post"
                          class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@item.CategoryId" />
                        <button class="btn btn-sm btn-danger">
                            Delete
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
<div class="mt-4">
    <a asp-controller="AdminDashboard"
       asp-action="Index"
       class="btn btn-secondary">
        ← Back to Dashboard
    </a>
</div>
