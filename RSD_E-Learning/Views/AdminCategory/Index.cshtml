@model RSD_E_Learning.Models.CategoryFilterVm

@{
    ViewData["Title"] = "Manage Categories";
}

<h2 class="mb-3">Manage Categories</h2>

<!-- ================= SEARCH + FILTER ================= -->
<div class="row g-2 mb-3 align-items-end">

    <div class="col-md-4">
        <label class="form-label fw-semibold">Search Category</label>
        <input id="search"
               value="@Model.Search"
               class="form-control"
               placeholder="Search category name..." />
    </div>

    <div class="col-md-3">
        <label class="form-label fw-semibold">Status</label>
        <select id="showDeleted" class="form-select">
            <option value="false" selected="@(!Model.ShowDeleted)">Active</option>
            <option value="true" selected="@(Model.ShowDeleted)">Deleted</option>
        </select>
    </div>

    <div class="col-md-2 d-grid">
        <button id="applyFilter" class="btn btn-primary">
            Apply
        </button>
    </div>

</div>

<a asp-action="Create" class="btn btn-success mb-3">
    + Add Category
</a>

<!-- ================= TABLE ================= -->
<div id="tableContainer">
    @await Html.PartialAsync("_CategoryTable", Model.Categories)
</div>

<a asp-controller="AdminDashboard"
   asp-action="Index"
   class="btn btn-secondary mt-3">
    ← Back to Dashboard
</a>

@section Scripts {
    <script>
        document.getElementById('applyFilter').addEventListener('click', function () {

            const search = document.getElementById('search').value;
            const showDeleted = document.getElementById('showDeleted').value;

            fetch(`/AdminCategory/AjaxList?search=${encodeURIComponent(search)}&showDeleted=${showDeleted}`)
                .then(res => res.text())
                .then(html => {
                    document.getElementById('tableContainer').innerHTML = html;
                });
        });
    </script>
}
