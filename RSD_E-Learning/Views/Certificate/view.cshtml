@model RSD_E_Learning.Models.DB.Certificate
@{
    ViewData["Title"] = "Certificate";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var template = ViewBag.Template as string ?? "Default";
}

@if (template.Contains("ModernBlue"))
{
    <partial name="Templates/_CertificateModernBlue" model="Model" />
}
else if (template.Contains("ClassicGold"))
{
    <partial name="Templates/_CertificateClassicGold" model="Model" />
}
else
{
    <partial name="Templates/_CertificateDefault" model="Model" />
}
