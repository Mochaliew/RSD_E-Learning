@model RSD_E_Learning.Models.DB.Certificate

<div class="container my-5">
    <div class="card shadow-lg p-5 text-center text-white"
         style="background: linear-gradient(135deg, #667eea, #764ba2)">
        <h1>Certificate of Completion</h1>
        <h2>@Model.Student?.User?.FullName</h2>
        <h4>@Model.Course?.Title</h4>
        <p>@Model.IssuedDate.ToString("MMMM dd, yyyy")</p>

        <img src="@ViewBag.QRCodeUrl" width="150" />
    </div>
</div>
