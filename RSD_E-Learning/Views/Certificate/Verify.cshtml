@model RSD_E_Learning.Models.DB.Certificate

<h2>Certificate Verification</h2>

@if (ViewBag.IsValid)
{
    <div class="alert alert-success">
        ✅ @ViewBag.Message
    </div>

    <ul class="list-group">
        <li class="list-group-item"><strong>Student:</strong> @Model.Student!.User!.FullName</li>
        <li class="list-group-item"><strong>Course:</strong> @Model.Course!.Title</li>
        <li class="list-group-item"><strong>Issued:</strong> @Model.IssuedDate.ToString("dd MMM yyyy")</li>
        <li class="list-group-item"><strong>ID:</strong> CERT-@Model.CertificateId.ToString("D6")</li>
    </ul>
}
else
{
    <div class="alert alert-danger">
        ❌ @ViewBag.Message
    </div>
}
