@model IEnumerable<RSD_E_Learning.Models.DB.Certificate>

<h2 class="mb-4">My Certificates</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">No certificates earned yet.</div>
}
else
{
    <table class="table table-bordered">
        <thead class="table-light">
            <tr>
                <th>Course</th>
                <th>Issued Date</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td>@c.Course!.Title</td>
                    <td>@c.IssuedDate.ToString("dd MMM yyyy")</td>
                    <td>
                        <a asp-action="View"
                           asp-route-id="@c.CertificateId"
                           class="btn btn-sm btn-primary">
                            View Certificate
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
