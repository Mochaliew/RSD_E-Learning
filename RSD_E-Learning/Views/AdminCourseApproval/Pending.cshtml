@model IEnumerable<RSD_E_Learning.Models.DB.Course>

@{
    ViewData["Title"] = "Pending Course Approval";
    Layout = "_Layout";
}

<h2 class="mb-3">Pending Course Approval</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-warning">@TempData["Error"]</div>
}

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Course Title</th>
            <th>Teacher</th>
            <th>Category</th>
            <th style="width:180px;">Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.Title</td>
                <td>@c.Teacher!.User!.FullName</td>
                <td>@c.Category!.Name</td>
                <td>
                    <form asp-action="Approve" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="courseId" value="@c.CourseId" />
                        <button class="btn btn-sm btn-success">Approve</button>
                    </form>

                    <form asp-action="Reject" method="post" class="d-inline ms-1">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="courseId" value="@c.CourseId" />
                        <button class="btn btn-sm btn-danger">Reject</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-controller="AdminDashboard"
   asp-action="Index"
   class="btn btn-secondary mt-3">
    ← Back to Dashboard
</a>
