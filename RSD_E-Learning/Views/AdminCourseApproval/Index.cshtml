@model IEnumerable<RSD_E_Learning.Models.DB.Course>

<h2>Pending Course Approvals</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Course</th>
            <th>Teacher</th>
            <th>Category</th>
            <th style="width:300px">Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.Title</td>
                <td>@c.Teacher!.User!.FullName</td>
                <td>@c.Category!.Name</td>
                <td>
                    <form asp-action="Approve" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@c.CourseId" />
                        <button class="btn btn-success btn-sm">Approve</button>
                    </form>

                    <form asp-action="Reject" method="post" class="mt-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@c.CourseId" />

                        <textarea name="reason"
                              class="form-control mb-1"
                              placeholder="Reason for rejection"
                              required></textarea>

                        <button class="btn btn-danger btn-sm">Reject</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-controller="AdminDashboard"
   asp-action="Index"
   class="btn btn-secondary mt-3">
    ← Back to Dashboard
</a>
