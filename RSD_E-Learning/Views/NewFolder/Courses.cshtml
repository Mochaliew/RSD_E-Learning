@model RSD_E_Learning.Models.DB.Category

@{
    ViewData["Title"] = Model.Name;
}

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-controller="Categories" asp-action="Index">Categories</a>
            </li>
            <li class="breadcrumb-item active">@Model.Name</li>
        </ol>
    </nav>

    <h2 class="mb-3">@Model.Name</h2>
    @if (!string.IsNullOrEmpty(Model.Description))
    {
        <p class="lead text-muted mb-4">@Model.Description</p>
    }

    <div class="row">
        @foreach (var course in Model.Courses)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">@course.Title</h5>
                        <p class="card-text">@course.Description</p>

                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <small class="text-muted">
                                <i class="bi bi-person"></i> @course.Teacher.User.FullName
                            </small>
                        </div>

                        <p class="text-success font-weight-bold mb-0">Free Course</p>
                    </div>
                    <div class="card-footer bg-white border-0">
                        <a asp-controller="Courses" asp-action="Details" asp-route-id="@course.CourseId"
                           class="btn btn-outline-primary btn-block">
                            View Details
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Courses.Any())
    {
        <div class="alert alert-info">
            <p class="mb-0">No courses available in this category yet.</p>
        </div>
    }
</div>