@model List<RSD_E_Learning.Models.DB.Course>

@{
    ViewData["Title"] = "Course Catalog";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Course Catalog</h2>
        <a asp-controller="Categories" asp-action="Index" class="btn btn-outline-secondary">
            Browse by Category
        </a>
    </div>

    <div class="row">
        @foreach (var course in Model)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <span class="badge badge-info mb-2">@course.Category.Name</span>
                        <h5 class="card-title">@course.Title</h5>
                        <p class="card-text text-muted">
                            @(course.Description?.Length > 100
                                                    ? course.Description.Substring(0, 100) + "..."
                                                    : course.Description)
                    </p>

                        <div class="mb-2">
                            <small class="text-muted">
                                <i class="bi bi-person"></i> @course.Teacher.User.FullName
                            </small>
                        </div>

                        <p class="text-success font-weight-bold mb-0">Free Course</p>
                    </div>
                    <div class="card-footer bg-white border-0">
                        <a asp-action="Details" asp-route-id="@course.CourseId"
                           class="btn btn-primary btn-block">
                            View Course
                        </a>
                    </div>
                </div>
            </div>
                }
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <p class="mb-0">No courses available at the moment. Check back later!</p>
        </div>
    }
</div>