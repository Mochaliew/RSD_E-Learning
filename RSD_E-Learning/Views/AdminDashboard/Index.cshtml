@model RSD_E_Learning.Models.AdminDashboardVm

@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_Layout";
}

<div class="admin-dashboard">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Admin Dashboard</h2>
        <small class="text-muted">
            Last updated: @Model.LastUpdated.ToString("dd MMM yyyy, HH:mm")
        </small>
    </div>

    <!-- SUMMARY CARDS -->
    <div class="row g-4 mb-4">

        <div class="col-md-3">
            <div class="card shadow-sm border-primary h-100">
                <div class="card-body">
                    <h6 class="text-primary fw-bold">Total Teachers</h6>
                    <h2>@Model.TotalTeachers</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-success h-100">
                <div class="card-body">
                    <h6 class="text-success fw-bold">Total Students</h6>
                    <h2>@Model.TotalStudents</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-warning h-100">
                <div class="card-body">
                    <h6 class="text-warning fw-bold">Total Courses</h6>
                    <h2>@Model.TotalCourses</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-info h-100">
                <div class="card-body">
                    <h6 class="text-info fw-bold">New Students (7 days)</h6>
                    <h2>@Model.NewStudentRegistrations</h2>
                </div>
            </div>
        </div>

    </div>

    <!-- SYSTEM OVERVIEW BAR CHART -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h5 class="mb-3">System Overview</h5>
            <canvas id="overviewChart" height="100"></canvas>
        </div>
    </div>

    <!-- ROLE & PERMISSIONS -->
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm border-light">
                <div class="card-body">
                    <h6 class="fw-bold mb-1">Role & Permissions</h6>
                    <p class="text-muted mb-2">
                        View system access control rules.
                    </p>
                    <a asp-controller="AdminRolePermission"
                       asp-action="Index"
                       class="btn btn-sm btn-outline-secondary">
                        View Details
                    </a>
                </div>
            </div>
        </div>
    </div>
    
    <!-- MANAGEMENT SHORTCUTS -->
    <div class="row g-4 mb-4">

        <div class="col-md-4">
            <a asp-controller="AdminTeacher" asp-action="Index"
               class="text-decoration-none text-dark">
                <div class="card shadow-sm h-100 admin-card">
                    <div class="card-body text-center">
                        <h5>Manage Teachers</h5>
                        <p class="text-muted mb-0">
                            Create, activate, deactivate and reset teacher accounts
                        </p>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-4">
            <a asp-controller="AdminStudent" asp-action="Index"
               class="text-decoration-none text-dark">
                <div class="card shadow-sm h-100 admin-card">
                    <div class="card-body text-center">
                        <h5>Manage Students</h5>
                        <p class="text-muted mb-0">
                            Manage students, enrollments and transactions
                        </p>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-4">
            <a asp-controller="AdminCourse" asp-action="Index"
               class="text-decoration-none text-dark">
                <div class="card shadow-sm h-100 admin-card">
                    <div class="card-body text-center">
                        <h5>Manage Courses</h5>
                        <p class="text-muted mb-0">
                            Approve, publish and monitor courses
                        </p>
                    </div>
                </div>
            </a>
        </div>

    </div>

    <div class="row g-4 mb-4">

        <div class="col-md-4">
            <a asp-controller="AdminCategory" asp-action="Index"
               class="text-decoration-none text-dark">
                <div class="card shadow-sm h-100 admin-card">
                    <div class="card-body text-center">
                        <h5>Manage Categories</h5>
                        <p class="text-muted mb-0">
                            Organize course categories
                        </p>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-4">
            <a asp-controller="AdminSystemSettings" asp-action="Index"
               class="text-decoration-none text-dark">
                <div class="card shadow-sm h-100 admin-card">
                    <div class="card-body text-center">
                        <h5>System Settings</h5>
                        <p class="text-muted mb-0">
                            Platform, email & certificate configuration
                        </p>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-4">
            <a asp-controller="AdminPromoCode" asp-action="Index"
               class="text-decoration-none text-dark">
                <div class="card shadow-sm h-100 admin-card">
                    <div class="card-body text-center">
                        <h5>Promo Codes</h5>
                        <p class="text-muted mb-0">
                            Manage discount campaigns
                        </p>
                    </div>
                </div>
            </a>
        </div>

    </div>

    <!-- ACTIVITY LOG -->
    <div class="card shadow-sm mt-4">
        <div class="card-body">
            <h5>Recent Activities</h5>

            @if (!Model.LatestActivities.Any())
            {
                <p class="text-muted">No recent activity.</p>
            }
            else
            {
                <ul class="list-group list-group-flush">
                    @foreach (var log in Model.LatestActivities)
                    {
                        <li class="list-group-item">
                            <small class="text-muted">
                                @log.Timestamp.ToString("dd MMM HH:mm")
                            </small>
                            – @log.Action
                        </li>
                    }
                </ul>
            }

            <a asp-controller="AdminAuditLog"
               asp-action="Index"
               class="btn btn-outline-dark mt-3">
                View Full Audit Log
            </a>

        </div>
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    new Chart(document.getElementById('overviewChart'), {
        type: 'bar',
        data: {
            labels: ['Students', 'Teachers', 'Courses'],
            datasets: [{
                data: [
                    @Model.TotalStudents,
                    @Model.TotalTeachers,
                    @Model.TotalCourses
                ],
                backgroundColor: ['#198754', '#0d6efd', '#ffc107']
            }]
        },
        options: {
            plugins: { legend: { display: false } }
        }
    });
</script>
