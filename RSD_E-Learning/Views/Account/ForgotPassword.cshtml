@{
    ViewData["Title"] = "Forgot Password";
}

<h2>Forgot Password</h2>

<form method="post">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label>Email</label>
        <input type="email" name="email" class="form-control" required />
    </div>

    <button type="submit" class="btn btn-primary">
        Send Reset Link
    </button>
</form>
