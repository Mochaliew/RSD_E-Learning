@model RSD_E_Learning.Models.StudentFilterVm
@Html.AntiForgeryToken()

@{
    ViewData["Title"] = "Manage Students";
}

<h2 class="mb-3">Manage Students</h2>

<!-- ================= SEARCH & FILTER ================= -->
<form id="filterForm" class="row g-2 mb-4 align-items-end">

    <div class="col-md-4">
        <label class="form-label fw-semibold">Search</label>
        <input name="search"
               value="@Model.Search"
               class="form-control"
               placeholder="Search name or email" />
    </div>

    <div class="col-md-3">
        <label class="form-label fw-semibold">Status</label>
        <select name="isActive" class="form-select">
            <option value="">All</option>
            <option value="true" selected="@(Model.IsActive == true)">Active</option>
            <option value="false" selected="@(Model.IsActive == false)">Inactive</option>
        </select>
    </div>

    <div class="col-md-3">
        <label class="form-label fw-semibold">Class</label>
        <select name="className" class="form-select">
            <option value="">All</option>
            @foreach (var cls in Model.ClassNames)
            {
                <option value="@cls" selected="@(Model.ClassName == cls)">
                    @cls
                </option>
            }
        </select>
    </div>

    <div class="col-md-2 d-grid">
        <button class="btn btn-primary">Apply</button>
    </div>

</form>

<!-- ================= BULK ACTION ================= -->
<form asp-action="BulkUpdateStatus" method="post">
    @Html.AntiForgeryToken()

    <div class="mb-3 d-flex gap-2">
        <button type="submit" name="actionType" value="activate"
                class="btn btn-outline-success">
            Activate Selected
        </button>

        <button type="submit" name="actionType" value="deactivate"
                class="btn btn-outline-danger">
            Deactivate Selected
        </button>
    </div>

    <div id="studentTable">
        @await Html.PartialAsync("_StudentTable", Model.Students)
    </div>
</form>

<a asp-controller="AdminDashboard"
   asp-action="Index"
   class="btn btn-secondary mt-3">
    ← Back to Dashboard
</a>

@section Scripts {
    <script>
        const form = document.getElementById('filterForm');
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

        form.addEventListener('submit', function (e) {
            e.preventDefault();

            const params = new URLSearchParams(new FormData(form)).toString();

            fetch('/AdminStudent/Filter?' + params)
                .then(res => res.text())
                .then(html => {
                    document.getElementById('studentTable').innerHTML = html;
                    attachToggleHandlers();
                    attachSelectAll();
                });
        });

        function attachToggleHandlers() {
            document.querySelectorAll('.toggle-btn').forEach(btn => {
                btn.onclick = function () {

                    const id = this.dataset.id;
                    const row = this.closest('tr');
                    const badge = row.querySelector('.status-badge');
                    const button = this;

                    fetch('/AdminStudent/ToggleStatusAjax', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token
                        },
                        body: JSON.stringify({ id: parseInt(id) })
                    })
                    .then(res => res.json())
                    .then(data => {
                        if (!data.success) return;

                        if (data.isActive) {
                            badge.textContent = 'Active';
                            badge.className = 'badge status-badge bg-success';
                            button.textContent = 'Deactivate';
                            button.className = 'btn btn-sm btn-outline-danger toggle-btn';
                        } else {
                            badge.textContent = 'Inactive';
                            badge.className = 'badge status-badge bg-secondary';
                            button.textContent = 'Activate';
                            button.className = 'btn btn-sm btn-outline-success toggle-btn';
                        }
                    });
                };
            });
        }

        function attachSelectAll() {
            document.getElementById('selectAll')?.addEventListener('change', function () {
                document.querySelectorAll('input[name="selectedIds"]').forEach(cb => {
                    cb.checked = this.checked;
                });
            });
        }

        attachToggleHandlers();
        attachSelectAll();
    </script>
}
