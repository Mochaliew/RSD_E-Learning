@model IEnumerable<RSD_E_Learning.Models.DB.Student>

@{
    ViewData["Title"] = "Manage Students";
    Layout = "_Layout";
}

<h2 class="mb-3">Manage Students</h2>

<table class="table table-bordered table-hover align-middle">
    <thead class="table-light">
        <tr>
            <th>Student Name</th>
            <th>Email</th>
            <th>Enrolled Courses</th>
            <th>Payment Status</th>
            <th>Account Status</th>
            <th style="width:170px;">Action</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var s in Model)
        {
            bool isAccountActive =
            s.User!.LockoutEnd == null ||
            s.User.LockoutEnd < DateTime.UtcNow;

            bool hasUnpaid = s.Enrollments.Any(e => !e.PaymentStatus);

            <tr>
                <td>
                    <strong>@s.User.FullName</strong>
                </td>

                <td>@s.User.Email</td>

                <td>
                    @if (s.Enrollments.Any())
                    {
                        <ul class="mb-0 ps-3">
                            @foreach (var e in s.Enrollments)
                            {
                                <li>@e.Course!.Title</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <span class="text-muted">No courses</span>
                    }
                </td>

                <td>
                    @if (hasUnpaid)
                    {
                        <span class="badge bg-danger">Unpaid</span>
                    }
                    else
                    {
                        <span class="badge bg-success">Paid</span>
                    }
                </td>

                <td>
                    @if (isAccountActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Deactivated</span>
                    }
                </td>

                <td>
                    <form asp-action="ToggleAccountStatus" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="studentId" value="@s.StudentId" />

                        <button type="submit"
                                class="btn btn-sm @(isAccountActive ? "btn-outline-warning" : "btn-outline-success")">
                            @(isAccountActive ? "Deactivate" : "Activate")
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="mt-4">
    <a asp-controller="AdminDashboard"
       asp-action="Index"
       class="btn btn-secondary">
        ← Back to Dashboard
    </a>
</div>
