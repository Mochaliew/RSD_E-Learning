@model IEnumerable<RSD_E_Learning.Models.DB.Student>

@{
    ViewData["Title"] = "Manage Students";
}

@Html.AntiForgeryToken()

<h2 class="mb-3">Manage Students</h2>

<table class="table table-bordered align-middle">
    <thead class="table-light">
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Class</th>
            <th>Status</th>
            <th style="width:220px;">Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var student in Model)
        {
            var isActive = student.User?.LockoutEnd == null;

            <tr>
                <td>@student.User?.FullName</td>
                <td>@student.User?.Email</td>
                <td>@student.ClassName</td>

                <!-- STATUS -->
                <td>
                    <span class="badge status-badge @(isActive ? "bg-success" : "bg-secondary")">
                        @(isActive ? "Active" : "Inactive")
                    </span>
                </td>

                <!-- ACTION -->
                <td>
                    <button type="button"
                            class="btn btn-sm toggle-btn fixed-btn
                                       @(isActive ? "btn-outline-danger" : "btn-outline-success")"
                            data-id="@student.StudentId">
                        @(isActive ? "Deactivate" : "Activate")
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-controller="AdminDashboard"
   asp-action="Index"
   class="btn btn-secondary mt-3">
    ← Back to Dashboard
</a>

@section Scripts {
    <script>
        document.querySelectorAll('.toggle-btn').forEach(btn => {
            btn.addEventListener('click', function () {

                const id = this.dataset.id;
                const row = this.closest('tr');
                const badge = row.querySelector('.status-badge');
                const button = this;

                fetch('/AdminStudent/ToggleStatusAjax', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken':
                            document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({ studentId: parseInt(id) })
                })
                .then(res => res.json())
                .then(data => {
                    if (!data.success) return;

                    if (data.isActive) {
                        badge.className = 'badge bg-success status-badge';
                        badge.innerText = 'Active';
                        button.innerText = 'Deactivate';
                        button.className = 'btn btn-sm btn-outline-danger toggle-btn fixed-btn';
                    } else {
                        badge.className = 'badge bg-secondary status-badge';
                        badge.innerText = 'Inactive';
                        button.innerText = 'Activate';
                        button.className = 'btn btn-sm btn-outline-success toggle-btn fixed-btn';
                    }
                });
            });
        });
    </script>
}
