@model IEnumerable<RSD_E_Learning.Models.DB.AuditLog>

@{
    ViewData["Title"] = "Audit Log";
}

<h2>System Audit Log</h2>

<!-- FILTER -->
<form method="get" class="mb-3">
    <label class="form-label fw-bold">Filter by Module:</label>

    <select name="module" class="form-select d-inline w-auto ms-2">
        <option value="">All</option>
        <option value="Teacher" selected="@(ViewBag.SelectedModule == "Teacher")">Teacher</option>
        <option value="Category" selected="@(ViewBag.SelectedModule == "Category")">Category</option>
        <option value="Course" selected="@(ViewBag.SelectedModule == "Course")">Course</option>
        <option value="Student" selected="@(ViewBag.SelectedModule == "Student")">Student</option>
    </select>

    <button type="submit" class="btn btn-primary ms-2">
        Apply
    </button>
</form>

<table class="table table-bordered table-striped">
    <thead class="table-light">
        <tr>
            <th>Date & Time</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="2" class="text-center text-muted">
                    No audit records found.
                </td>
            </tr>
        }
        else
        {
            foreach (var log in Model)
            {
                <tr>
                    <td>@log.Timestamp.ToString("dd MMM yyyy HH:mm")</td>
                    <td>@log.Action</td>
                </tr>
            }
        }
    </tbody>
</table>

<a asp-controller="AdminDashboard"
   asp-action="Index"
   class="btn btn-secondary">
    ← Back to Dashboard
</a>
