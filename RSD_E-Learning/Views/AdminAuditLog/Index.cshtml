@model IEnumerable<RSD_E_Learning.Models.DB.AuditLog>

@{
    ViewData["Title"] = "Audit Log";
}

<h2 class="mb-4">System Audit Log</h2>

<!-- ================= FILTER ================= -->
<div class="row g-3 align-items-end mb-4">
    <div class="col-md-4">
        <label class="form-label fw-semibold">Filter by Module</label>
        <select id="moduleFilter" class="form-select">
            <option value="">All</option>
            <option value="Teacher">Teacher</option>
            <option value="Student">Student</option>
            <option value="Course">Course</option>
            <option value="Category">Category</option>
        </select>
    </div>

    <div class="col-md-2">
        <button id="applyFilter" class="btn btn-primary w-100">
            Apply
        </button>
    </div>
</div>

<!-- ================= TABLE (AJAX TARGET) ================= -->
<div id="auditLogTable">
    @await Html.PartialAsync("_AuditLogTable", Model)
</div>

<a asp-controller="AdminDashboard"
   asp-action="Index"
   class="btn btn-secondary mt-3">
    ← Back to Dashboard
</a>

@section Scripts {
    <script>
        document.getElementById("applyFilter").addEventListener("click", function () {
            const module = document.getElementById("moduleFilter").value;

            fetch(`/AdminAuditLog/Filter?module=${module}`)
                .then(res => res.text())
                .then(html => {
                    document.getElementById("auditLogTable").innerHTML = html;
                });
        });
    </script>
}
